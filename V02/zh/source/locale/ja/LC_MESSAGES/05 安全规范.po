msgstr "複数ステーションへのワークの着脱"

#: ../../source/05 安全规范.rst:156
msgid "自动分拣"
msgstr "自動仕分け"

#: ../../source/05 安全规范.rst:157
msgid "零部件转运"
msgstr "部品搬送"

#: ../../source/05 安全规范.rst:158
msgid "检测"
msgstr "検査"

#: ../../source/05 安全规范.rst:159
msgid "巡逻"
msgstr "巡回"

